# ---- App ----
APP_NAME=Research Scout
ENVIRONMENT=development
DEBUG=true
TIMEZONE=Asia/Shanghai

# ---- Database / Redis ----
# For local quick start without PostgreSQL, use:
# DATABASE_URL=sqlite+aiosqlite:///./research_scout.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_scout
REDIS_URL=redis://localhost:6379/0
# Log every SQL statement (very noisy; development only).
SQL_ECHO=false

# ---- Auth ----
JWT_SECRET=please-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Bootstrap ----
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
# Load mock posts, demo user and watchlist on startup (development only).
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# ---- LLM: OpenAI-compatible ----
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_UTILITY=deepseek-v4-flash
LLM_MODEL_ANALYZE=deepseek-v4-flash
LLM_MODEL_AGGREGATE=deepseek-v4-flash
LLM_DAILY_BUDGET=0
# Set to true to use the deterministic local analyzer (no API key required).
LLM_MOCK=true

# ---- Crawl ----
CRAWL_DAILY_HOUR=6
CRAWL_DAILY_MINUTE=30
CRAWL_REQUEST_TIMEOUT=15
CRAWL_MAX_ITEMS_PER_CHANNEL=50
# On backend startup, crawl immediately if the last successful crawl is older
# than this many minutes. Set STARTUP_REFRESH_ENABLED=false to disable.
STARTUP_REFRESH_ENABLED=true
STARTUP_REFRESH_STALE_MINUTES=60

# ---- Author-targeted crawling ----
# Xueqiu is fetched per author timeline only (never site-wide). Export the
# Cookie header from a logged-in browser session. The crawler fails closed with
# crawl_status=credentials_missing when it is absent or expired.
XUEQIU_COOKIE=
AUTHOR_CRAWL_ENABLED=true
AUTHOR_CRAWL_ITEMS_PER_AUTHOR=20
AUTHOR_CRAWL_MAX_AUTHORS=50
AUTHOR_CRAWL_MIN_INTERVAL_MINUTES=60
AUTHOR_CRAWL_INTERVAL_MINUTES=30

# ---- Daily digest email ----
# The in-app digest always works. Email additionally requires SMTP_HOST and a
# user opt-in (Settings → 每日邮件).
DIGEST_EMAIL_ENABLED=true
DIGEST_EMAIL_HOUR=7
DIGEST_EMAIL_MINUTE=10
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Research Scout <noreply@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Frontend ----
# The Vite dev server proxies /api to :8000, and the Docker image proxies /api
# through Nginx. Only set VITE_API_BASE_URL in frontend/.env when the API lives
# on a different origin.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
